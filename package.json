{
  "name": "trebuchet",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=26.5.1"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"pnpm --filter @trebuchet/server dev\" \"pnpm --filter @trebuchet/web dev\"",
    "start": "pnpm --filter @trebuchet/web build && pnpm --filter @trebuchet/server start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --parallel typecheck && tsc -p scripts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "bench:reports": "node scripts/bench-reports.ts",
    "bench:import": "node scripts/bench-import.ts",
    "bench:backup": "node scripts/bench-backup.ts",
    "bench:statements": "node scripts/bench-statements.ts",
    "eval:columns": "node scripts/eval-column-suggestions.ts",
    "eval:receipts": "node scripts/eval-receipts.ts",
    "restore": "node scripts/restore-backup.ts",
    "verify:freee": "node scripts/verify-freee-import.ts",
    "verify:tax-return": "node scripts/verify-tax-return.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
